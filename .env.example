# 客情评估智能体 — 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）
# 所有变量均有默认值，仅 LLM 相关为可选（不配则自动降级为规则引擎）

# ── 数据库 ──
DB_PATH=./customer_health.db

# ── LLM（不配置则 LLM_ENABLED 自动视为不可用，全部走规则引擎降级）──
LLM_ENABLED=true
# ── 密钥加密（可选，推荐服务器部署时使用）──────────────────────────
# 把 .env 中的 LLM_API_KEY / LLM_EMBEDDING_API_KEY 加密为 enc: 前缀密文：
#   python backend/scripts/encrypt_env.py --key-file /root/.ch_secret
# 解密密钥单独存服务器 /root/.ch_secret（权限 600），compose 自动挂载到容器
# /run/secrets/ch_secret；也可用环境变量 CH_SECRET_KEY 提供（优先级更高）。
# 本地开发（不跑 Docker）时，把这里改成 SECRET_KEY_FILE=./.ch_secret，
# 或直接使用 CH_SECRET_KEY 环境变量；密钥文件缺失时后端会告警并按明文使用，不会启动失败。
# 未使用 enc: 前缀时本项可忽略，.env 保持明文即可。
SECRET_KEY_FILE=/run/secrets/ch_secret
# 对话模型（需支持流式与函数调用，按所选服务商填写）
# 大模型兼容端点（不带 /v1，适配器自行拼接 /chat/completions）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 对话输出 token 上限（作为 prompt_templates.yaml 模板 max_tokens 的硬上限）
LLM_MAX_TOKENS=8000
# 向量化模型（大模型兼容 /embeddings 端点）
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=
# 是否启用函数调用工具（customer_compare / knowledge_search；不支持的网关会自动降级重试）
LLM_TOOLS_ENABLED=true

# ── 知识库 / RAG ──
# 向量库：chroma（生产，需安装 chromadb）| memory（零依赖，测试/dev）
KNOWLEDGE_VECTOR_STORE=chroma
# 重排：metadata（零依赖默认）| bge（需安装 FlagEmbedding + torch）
RERANKER=metadata
# 召回后重排保留条数
RAG_TOP_K=5
# 命中切片窗口扩展：把相邻切片一起拼进上下文，缓解跨切片信息截断（0=关闭）
RAG_WINDOW=1

# ── 对话趋势点位 ──
CHAT_TREND_POINTS=6

# ── 异步 PDF 导出任务 ──
# 进程内最多保留的任务数（超出清理最早完成的 ready/error）
PDF_JOB_MAX=50
# 并发生成上限（超出返回 429，防止线程/内存被打满）
PDF_JOB_MAX_CONCURRENT=4
# 任务 TTL 秒数（含疑似挂死的 running，超时回收）
PDF_JOB_TTL=3600
