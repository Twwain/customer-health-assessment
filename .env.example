# 客情评估智能体 v3.0 — 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）
# 所有变量均有默认值，仅 LLM 相关为可选（不配则自动降级为规则引擎）

# ── 数据库 ──
DB_PATH=./customer_health.db

# ── LLM（不配置则 LLM_ENABLED 自动视为不可用，全部走规则引擎降级）──
LLM_ENABLED=true
# DeepSeek-V4-Flash（对话生成）
# 官方 OpenAI 兼容端点为 https://api.deepseek.com（不带 /v1）；模型版本 DeepSeek-V4-Flash-0731，
# API 模型标识为小写 deepseek-v4-flash（官方约定：该标识始终指向最新版本）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 智谱 GLM embedding-3（向量化，OpenAI 兼容）
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_EMBEDDING_MODEL=embedding-3
# 是否启用函数调用工具（customer_compare / knowledge_search；不支持的网关会自动降级重试）
LLM_TOOLS_ENABLED=true

# ── 知识库 / RAG ──
# 向量库：chroma（生产，需安装 chromadb）| memory（零依赖，测试/dev）
KNOWLEDGE_VECTOR_STORE=chroma
# 重排：metadata（零依赖默认）| bge（需安装 FlagEmbedding + torch）
RERANKER=metadata
# 召回后重排保留条数
RAG_TOP_K=5
# 命中切片窗口扩展：把相邻切片一起拼进上下文，缓解跨切片信息截断（0=关闭）
RAG_WINDOW=1

# ── 对话趋势点位 ──
CHAT_TREND_POINTS=6
