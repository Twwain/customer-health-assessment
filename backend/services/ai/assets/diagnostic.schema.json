{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stage": {
      "enum": [
        "run_created",
        "assets_verified",
        "capture_ready",
        "retrieval_ready",
        "before_intent",
        "before_plan",
        "before_repair",
        "failure",
        "success"
      ]
    },
    "error_code": {
      "type": "string",
      "pattern": "^[a-z_]{1,50}$"
    },
    "pointer": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(/(intents|status|version|clarification_code|summary_refs|risks|detail_refs|actions|verification_questions|projections|strength_refs|hypotheses)(/[0-9]{1,3})?(/(kind|subject_refs|field_refs|option_refs|source_refs|count|section|render_ref|changes|id|purpose|template_ref|object_refs|priority|candidate_ref|slot_id|value))?)?$"
    },
    "json_type": {
      "enum": [
        "missing",
        "null",
        "boolean",
        "integer",
        "number",
        "string",
        "array",
        "object",
        "invalid_json"
      ]
    },
    "value_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "response_bytes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "allowed_count": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9_.-]+$"
      },
      "maxItems": 8
    },
    "truncated_count": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_key_count": {
      "type": "integer",
      "minimum": 0
    },
    "rule_version": {
      "const": "1.1"
    },
    "source_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stage",
    "error_code",
    "pointer",
    "json_type",
    "value_sha256",
    "response_bytes",
    "allowed_count",
    "allowed_ids",
    "truncated_count",
    "unknown_key_count",
    "rule_version",
    "source_fingerprint"
  ]
}
